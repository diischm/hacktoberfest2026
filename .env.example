# Copy to .env (`cp .env.example .env`) and fill in. .env is git-ignored; never commit it.
# Everything here is optional: with no .env the app runs in dev mode with AI_MODE=mock.

# --- Django ---
# Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
# Required when DJANGO_DEBUG=false.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
# Extra hosts, comma-separated (localhost and 127.0.0.1 are always allowed).
# Add your laptop's LAN IP so phones on the same Wi-Fi can open http://<ip>:8000
DJANGO_ALLOWED_HOSTS=192.168.1.50

# --- AI (Google Gemini) ---
# "mock" = canned answers, no network calls (default; use this for tests and most dev work).
# "live" = call the real Gemini API. Falls back to mock if the key or model is empty.
AI_MODE=mock
# Free-tier key from Google AI Studio: https://aistudio.google.com -> "Get API key".
# Not Vertex AI, no Google Cloud project needed. The free tier is rate-limited, so keep
# AI_MODE=mock unless you're actively testing the AI.
GEMINI_API_KEY=
# Model name, e.g. gemini-3.8-flash. Check AI Studio for models available on the free tier
# (new keys can no longer use gemini-2.5-flash).
GEMINI_MODEL=
# Mock mode only, to try the error screens: rate_limited | unavailable | empty (normal answers).
AI_MOCK_FORCE=
